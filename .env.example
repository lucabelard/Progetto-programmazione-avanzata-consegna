# ==============================
# Application
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ==============================
# Database (PostgreSQL)
# ==============================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=progetto_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_DIALECT=postgres
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ==============================
# JWT – RS256 (chiave privata RSA)
#
# Per generare le chiavi:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#
# Poi, per inserirle qui come variabili d'ambiente su una riga sola,
# sostituisci i newline con \n:
#   awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
# ==============================
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...la tua chiave privata...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...la tua chiave pubblica...\n-----END PUBLIC KEY-----"
JWT_EXPIRES_IN=24h

# ==============================
# Business Logic
# ==============================
# Credito token iniziale assegnato ad ogni nuovo utente
INITIAL_USER_TOKENS=100

# ==============================
# Logging
# ==============================
LOG_LEVEL=debug
